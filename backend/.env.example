NODE_ENV=development
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=contas_db
DB_USER=root
DB_PASSWORD=
JWT_SECRET=sua_chave_secreta_jwt_aqui_altere_em_producao
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10

# Configurações de Email
EMAIL_HOST=email-ssl.com.br
EMAIL_PORT=465
EMAIL_USER=MEU_EMAIL
EMAIL_PASS=MINHA_SENHA
EMAIL_FROM=MEU_EMAIL

# URL do Frontend (usado nos links de email)
# RECOMENDADO se você usa Custom Domain (ex: numix.cinoto.com.br)
# Configure no Render: FRONTEND_URL=https://numix.cinoto.com.br
# Se não configurar, tenta detectar automaticamente (RENDER_EXTERNAL_URL, etc)
# Em desenvolvimento: http://localhost:3001
# FRONTEND_URL=http://localhost:3001

